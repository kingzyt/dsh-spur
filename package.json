{
  "name": "@kingzyt/dsh-spur",
  "version": "1.0.0",
  "type": "module",
  "description": "提醒停下来的会话继续做完；右侧面板可开关、看记录、自动压缩，支持空闲触发与兜底巡检。",
  "engines": {
    "dsh": ">=0.2.2-rc.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingzyt/dsh-spur.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
